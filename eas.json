{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "node": "22.12.0",
      "env": {
        "EAS_BUILD_NPM_INSTALL_FLAGS": "--legacy-peer-deps",
        "EAS_BUILD_USE_NPM_INSTALL": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "node": "22.12.0",
      "env": {
        "EAS_BUILD_NPM_INSTALL_FLAGS": "--legacy-peer-deps",
        "EAS_BUILD_USE_NPM_INSTALL": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
